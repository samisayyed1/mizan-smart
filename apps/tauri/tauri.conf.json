{
  "build": {
    "beforeDevCommand": "node ./apps/tauri/scripts/sync-ios-composer-icon.mjs && pnpm --filter frontend dev:tauri",
    "beforeBuildCommand": "node ./apps/tauri/scripts/sync-ios-composer-icon.mjs && pnpm --filter frontend build:tauri",
    "frontendDist": "../../dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/ios/AppIcon-512@2x.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "2026 Mizan contributors. Originally Copyright (c) Teymz Inc. (Wealthfolio).",
    "category": "public.app-category.finance",
    "macOS": {
      "bundleVersion": "20260301.1",
      "minimumSystemVersion": "10.13"
    }
  },
  "productName": "Mizan",
  "mainBinaryName": "Mizan",
  "version": "3.3.0",
  "identifier": "app.mizan",
  "plugins": {
    "deep-link": {
      "mobile": [
        { "host": "connect.mizan.app", "pathPrefix": ["/deeplink"] },
        { "host": "connect-staging.mizan.app", "pathPrefix": ["/deeplink"] }
      ],
      "desktop": {
        "schemes": ["mizan"]
      },
      "schemes": ["mizan"]
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "dragDropEnabled": false,
        "fullscreen": false,
        "resizable": true,
        "theme": "Light",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "title": "Mizan",
        "width": 1440,
        "height": 960
      }
    ],
    "security": {
      "csp": null
    }
  }
}
